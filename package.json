{
  "name": "kompletr",
  "version": "2.1.10",
  "description": "Vanilla JS autocomplete module",
  "main": "src/js/index.js",
  "type": "module",
  "author": {
    "name": "Steve Lebleu",
    "email": "steve@konfer.be",
    "url": "https://www.konfer.be"
  },
  "homepage": "https://github.com/steve-lebleu/kompletr",
  "repository": {
    "type": "git",
    "url": "https://github.com/steve-lebleu/kompletr.git"
  },
  "bugs": {
    "url": "https://github.com/steve-lebleu/kompletr/issues",
    "email": "steve@konfer.be"
  },
  "demo": "https://kompletr.konfer.be/",
  "download": "",
  "directories": {
    "src": "src",
    "dist": "dist",
    "docs": "docs"
  },
  "files": [
    "dist",
    "src"
  ],
  "browser": "dist/js/kompletr.min.js",
  "unpkg": "dist/js/kompletr.min.js",
  "module": "dist/js/kompletr.min.js",
  "keywords": [
    "html",
    "html5",
    "css",
    "css3",
    "vanilla",
    "javascript",
    "plugin",
    "auto-complete",
    "auto-completion",
    "autocomplete",
    "autocompletion"
  ],
  "license": "ISC",
  "scripts": {
    "build": "webpack --mode development --config ./webpack.dev.js",
    "ci:dev": "webpack serve --mode development --config ./webpack.dev.js",
    "ci:e2e": "cypress run --browser chrome ./cypress",
    "ci:cy": "cypress open",
    "ci:test": "node --experimental-vm-modules node_modules/jest/bin/jest.js ./test/**.spec.js -- --coverage",
    "demo": "mkdir -p demo && mkdir -p demo/js && npm run demo:css && npm run demo:css-demo && npm run demo:html && npm run demo:js",
    "demo:css": "npx sass ./src/sass/kompletr.scss ./demo/css/kompletr.min.css --style compressed",
    "demo:css-demo": "npx sass ./src/sass/kompletr.demo.scss ./demo/css/kompletr.demo.min.css --style compressed",
    "demo:html": "cp ./src/index.demo.html ./demo/index.html",
    "demo:js": "cp ./dist/js/kompletr.min.js ./demo/js/kompletr.min.js",
    "dev": "webpack serve --hot --mode development --config ./webpack.dev.js",
    "dist": "mkdir -p dist & npm run dist:css && npm run dist:js",
    "dist:css": "npx sass ./src/sass/kompletr.scss ./dist/css/kompletr.min.css --style compressed",
    "dist:js": "webpack --mode production --config ./webpack.prod.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint ./src/js/",
    "lint:css": "stylelint ./src/sass/"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.23.6",
    "@jest/globals": "^29.7.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "cypress": "^13.6.3",
    "esbuild-loader": "^4.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-compat": "^4.2.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^24.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "node-sass": "^9.0.0",
    "prettier": "^3.2.5",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "stylelint": "^16.2.1",
    "stylelint-config-sass-guidelines": "^11.1.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.1",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.0",
    "stylelint-selector-bem-pattern": "^4.0.0",
    "terser": "^5.37.0",
    "terser-webpack-plugin": "^5.3.11",
    "vitepress": "^1.0.0-rc.45",
    "vitepress-plugin-tabs": "^0.5.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
